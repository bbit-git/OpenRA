<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net9.0-android35.0</TargetFramework>
		<SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseMaui>false</UseMaui>
		<UseAppHost>false</UseAppHost>
		<RuntimeIdentifiers></RuntimeIdentifiers>
		<!-- Android-specific workaround: package the managed runtime for arm64 only. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">android-arm64</RuntimeIdentifier>
		<AndroidSupportedAbis>armeabi-v7a;arm64-v8a;x86_64</AndroidSupportedAbis>
		<NoWarn>$(NoWarn);XA0036</NoWarn>
		<!-- Android-specific -->
		<AndroidApplication>true</AndroidApplication>
		<AndroidGenerateApplicationPackage>true</AndroidGenerateApplicationPackage>
		<!-- Default to fat APK for sideloading; pass -p:AndroidPackageFormat=aab for Play Store -->
		<AndroidPackageFormat Condition="'$(AndroidPackageFormat)'==''">apk</AndroidPackageFormat>
		<!-- Version wired to VERSION file; override with VERSION_ANDROID if present.
		     .NET Android manifest generation uses ApplicationDisplayVersion/ApplicationVersion. -->
		<ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)'=='' AND Exists('$(MSBuildProjectDirectory)/../VERSION_ANDROID')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION_ANDROID').Trim().Split()[0])</ApplicationDisplayVersion>
		<ApplicationVersion Condition="'$(ApplicationVersion)'=='' AND Exists('$(MSBuildProjectDirectory)/../VERSION_ANDROID')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION_ANDROID').Trim().Split()[1])</ApplicationVersion>
		<ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)'==''">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION').Trim().Split('-')[0])</ApplicationDisplayVersion>
		<ApplicationVersion Condition="'$(ApplicationVersion)'=='' AND '$(BUILD_NUMBER)'!=''">$(BUILD_NUMBER)</ApplicationVersion>
		<!-- Android versionCode fallback: yyMMddB where B is the intra-day build digit.
		     Default local builds use B=1; CI or release builds can override via BUILD_NUMBER
		     or VERSION_ANDROID for subsequent same-day uploads. -->
		<ApplicationVersion Condition="'$(ApplicationVersion)'==''">$([System.DateTime]::Now.ToString('yyMMdd'))1</ApplicationVersion>
		<!-- Stability fixes for Mono on Android -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidLinkMode>None</AndroidLinkMode>
		<!-- Override global OutputPath to avoid metadata conflicts -->
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
		<OutputPath>obj/bin</OutputPath>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj"/>
		<ProjectReference Include="..\OpenRA.Platforms.SDL2\OpenRA.Platforms.SDL2.csproj"/>
		<ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj"/>
		<ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj"/>
		<ProjectReference Include="..\OpenRA.Mods.D2k\OpenRA.Mods.D2k.csproj"/>
	</ItemGroup>


	<ItemGroup>
		<!-- sdl2.jar is recompiled from our patched Java sources (SDLMain calls runGameLoop() via
		     reflection). Bind=true lets the C# compiler see Org.Libsdl.App.SDLActivity so that
		     MainActivity can extend it directly. -->
		<AndroidLibrary Include="sdl2.jar" Bind="true" />
		<AndroidJavaSource Remove="java\**\*.java" />
		<!-- Android-specific workaround: keep non-SDL Java glue in the normal Android build
		     so it does not depend on the repacked SDL jar step. -->
		<AndroidJavaSource Include="Java\**\*.java" />
	</ItemGroup>


	<ItemGroup>
		<AndroidResource Include="Resources\mipmap-*\*.png" />
		<AndroidResource Include="Resources\drawable-nodpi\*.png" />
		<AndroidResource Include="Resources\drawable\*.xml" />
		<AndroidResource Include="Resources\layout\*.xml" />
		<AndroidResource Include="Resources\values\*.xml" />
	</ItemGroup>

	<ItemGroup>
		<AndroidNativeLibrary Include="libs\armeabi-v7a\libSDL2.so" Abi="armeabi-v7a" />
		<AndroidNativeLibrary Include="libs\arm64-v8a\libSDL2.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="libs\x86_64\libSDL2.so" Abi="x86_64" />
		<AndroidNativeLibrary Include="libs\armeabi-v7a\libfreetype6.so" Abi="armeabi-v7a" />
		<AndroidNativeLibrary Include="libs\arm64-v8a\libfreetype6.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="libs\x86_64\libfreetype6.so" Abi="x86_64" />
		<AndroidNativeLibrary Include="libs\armeabi-v7a\libsoft_oal.so" Abi="armeabi-v7a" />
		<AndroidNativeLibrary Include="libs\arm64-v8a\libsoft_oal.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="libs\x86_64\libsoft_oal.so" Abi="x86_64" />
		<AndroidNativeLibrary Include="libs\armeabi-v7a\liblua51.so" Abi="armeabi-v7a" />
		<AndroidNativeLibrary Include="libs\arm64-v8a\liblua51.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="libs\x86_64\liblua51.so" Abi="x86_64" />
	</ItemGroup>

	<!-- Engine data: mods, shaders, and VERSION bundled as Android assets -->
	<ItemGroup>
		<AndroidAsset Include="..\VERSION" Link="Assets\engine\VERSION" />
		<AndroidAsset Include="..\global mix database.dat" Link="Assets\engine\global mix database.dat" />
		<AndroidAsset Include="..\glsl\**" Link="Assets\engine\glsl\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\common\**" Link="Assets\engine\mods\common\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\common-content\**" Link="Assets\engine\mods\common-content\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\common-touch\**" Link="Assets\engine\mods\common-touch\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\ra\**" Link="Assets\engine\mods\ra\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\ra-content\**" Link="Assets\engine\mods\ra-content\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\cnc\**" Link="Assets\engine\mods\cnc\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\cnc-content\**" Link="Assets\engine\mods\cnc-content\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\d2k\**" Link="Assets\engine\mods\d2k\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\d2k-content\**" Link="Assets\engine\mods\d2k-content\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\ts\**" Link="Assets\engine\mods\ts\%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidAsset Include="..\mods\ts-content\**" Link="Assets\engine\mods\ts-content\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
