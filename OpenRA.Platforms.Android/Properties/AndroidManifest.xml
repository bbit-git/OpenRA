<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.bigbangit.openra.android">
	<uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
	<application android:allowBackup="false" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:extractNativeLibs="true" android:theme="@style/SplashTheme">
		<!-- Android-specific workaround: use a Java ContentProvider so Android can create it
		     before the .NET runtime is initialized. -->
		<provider
			android:name="com.bigbangit.openra.android.OpenRAContentProvider"
			android:authorities="com.bigbangit.openra.android.content"
			android:exported="true"
			android:readPermission="com.bigbangit.openra.android.permission.WRITE_CONTENT"
			android:writePermission="com.bigbangit.openra.android.permission.WRITE_CONTENT" />
	</application>
	<!-- Signature permission for content provider: only apps signed with the same key can access -->
	<permission
		android:name="com.bigbangit.openra.android.permission.WRITE_CONTENT"
		android:protectionLevel="signature"
		android:label="Write OpenRA content files"
		android:description="@string/app_name" />
	<uses-permission android:name="android.permission.INTERNET" />
</manifest>
