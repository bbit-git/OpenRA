## ingame-player.yaml
button-command-bar-force-move =
    .tooltip = Vynutit pohyb
    .tooltipdesc =
    Vybrane jednotky se presunou na zvolene misto
     - Vychozi aktivita pro cil je potlacena
     - Vozidla se pokusi prejet nepritele v cilovem miste
     - Rozlozene jednotky se sbali a presunou na cilove misto
     - Vrtulniky pristane na cilovem miste

    Kliknete levym tlacitkem na ikonu a pote pravym na cil.
    Podrzte <(Alt)> pro docasnou aktivaci pri rozkazovani jednotkam.

button-command-bar-force-attack =
    .tooltip = Vynutit utok
    .tooltipdesc =
    Vybrane jednotky zautoci na zvolenou jednotku nebo misto
     - Vychozi aktivita pro cil je potlacena
     - Umoznuje zacit na vlastni nebo spojenecke sily
     - Delostrelecke jednotky s dlouhym dosahem budou vzdy cilit na
       misto a ignorovat jednotky i budovy

    Kliknete levym tlacitkem na ikonu a pote pravym na cil.
    Podrzte <(Ctrl)> pro docasnou aktivaci pri rozkazovani jednotkam.


button-command-bar-deploy =
    .tooltip = Nasadit
    .tooltipdesc =
    Vybrane jednotky provedou svoji vychozi akci nasazeni
     - MCV se rozlozi na stavebni dvur
     - Stavebni dvory se zabali zpet na MCV
     - Transporty vylozi sve pasazery
     - Tick tanky, delostrelectvo, juggernauty
       a mobilni senzorova pole se rozlozi
     - Letadla se vrati na zakladnu

    Pusobi okamzite na vybrane jednotky.


