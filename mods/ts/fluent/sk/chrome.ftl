## ingame-player.yaml
button-command-bar-force-move =
    .tooltip = Vynútiť pohyb
    .tooltipdesc =
        Vybrané jednotky sa presunú na požadované miesto
         - Predvolená aktivita pre cieľ je potlačená
         - Vozidlá sa pokúsia rozdrviť nepriateľov na cieľovom mieste
         - Nasadené jednotky sa odložia a presunú na cieľové miesto
         - Vrtuľníky pristanú na cieľovom mieste
        
        Kliknite ľavým tlačidlom myši na ikonu a potom kliknite pravým tlačidlom myši na cieľ.
        Počas ovládania jednotiek podržte <(Alt)> na dočasnú aktiváciu.

button-command-bar-force-attack =
    .tooltip = Silový útok
    .tooltipdesc =
        Vybrané jednotky zaútočia na cieľovú jednotku alebo miesto
         - Predvolená aktivita pre cieľ je potlačená
         - Umožňuje zacielenie vlastných alebo spojeneckých síl
         - Diaľkové delostrelecké jednotky sa vždy zamerajú na
           umiestnenie, ignorovanie jednotiek a budov
        
        Kliknite ľavým tlačidlom myši na ikonu a potom kliknite pravým tlačidlom myši na cieľ.
        Počas ovládania jednotiek podržte <(Ctrl)> na dočasnú aktiváciu.


button-command-bar-deploy =
    .tooltip = Nasadiť
    .tooltipdesc =
        Vybrané jednotky vykonajú svoju predvolenú aktivitu nasadenia
         - MCV sa vybalia na Stavebnom dvore
         - Stavebné dvory budú prebalené do MCV
         - Transporty vyložia svojich pasažierov
         - Kliešťové tanky, delostrelectvo, Juggernauty,
           a nasadí sa polia mobilných senzorov
         - Lietadlo sa vráti na základňu
        
        Okamžite pôsobí na vybrané jednotky.


