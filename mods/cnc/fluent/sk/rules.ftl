## infantry.yaml
actor-e1 =
    .name = Pešiak
    .description =
        Viacúčelová pechota.
          Silná proti pechote
          Slabá proti vozidlám
    .encyclopedia =
        Nenápadný Minigunner je vysoko špecializovaná pechotná jednotka určená na pohlcovanie poškodenia a likvidáciu inej pechoty.
        
        Podobne ako väčšina jednotiek v TD vidí ďalej, než dokáže strieľať, a najlepšie funguje vo väčších skupinách pri likvidácii nepriateľskej pechoty.

actor-e2 =
    .name = Grenadír
    .description =
        Rýchla pechota s granátmi.
          Silná proti budovám a pomaly sa pohybujúcim cieľom
    .encyclopedia =
        Je rýchla a dokáže držať krok so strednými tankmi, takže dobre funguje vo flankujúcich armádach.
        
        Hoci nie je taká silná ako Minigunner alebo raketový vojak, jej rýchlosť sa dá využiť vo váš prospech.

actor-e3 =
    .name = Raketometčík
    .description =
        Protitanková/protilietadlová pechota.
          Silná proti tankom a lietadlám
          Slabá proti pechote
    .encyclopedia =
        Je veľmi zraniteľná, ale vyniká pri ničení nepriateľského panciera a lietadiel. Je to najpomalšia jednotka v hre, zaostávajúca za ostatnou pechotou aj za tankami Mammoth.
        
        Veľký dosah zbrane kompenzuje jej nízku rýchlosť, takže je najúčinnejšia pri obrannom použití, kde ju možno chrániť a zároveň poskytuje výhľad.

actor-e4 =
    .name = Plameňometčík
    .description =
        Pokročilá protipechotná jednotka.
          Silná proti pechote a budovám
          Slabá proti tankom
    .encyclopedia = Hodí sa na obchvaty a vypaľovanie stavieb. Má viac životov než bežný Minigunner, no jej krátky dostrel sťažuje použitie vo veľkých armádach.

actor-e5 =
    .name = Chemický vojak
    .description =
        Pokročilá viacúčelová pechota.
          Silná proti všetkým pozemným jednotkám
    .encyclopedia =
        Má podobné parametre ako plameňometník, ale spôsobuje dobré poškodenie ťažkému pancieru. Výborne zastavuje nepriateľské obrnené jednotky, aby nerozdrvili vaše sily.
        
        Dokáže chodiť po Tiberiu bez poškodenia, čo ho robí obzvlášť užitočným pri obťažovaní harvesterov na niektorých mapách.

actor-e6 =
    .name = Inžinier
    .description =
        Poškodzuje a obsadzuje nepriateľské budovy.
        Opravuje zničené vozidlá.
          Neozbrojený
    .encyclopedia =
        Rovnako ako raketový vojak je Inžinier pomalý a na efektívne použitie potrebuje sprievod. Dokáže okamžite obsadzovať budovy, no pri tom sa spotrebuje.
        
        Na obsadenie civilnej budovy stačí jeden inžinier, zatiaľ čo na obsadenie nepriateľskej budovy sú zvyčajne potrební dvaja, alebo jeden, ak je budova silno poškodená.
        
        Inžinierov možno použiť aj na opravu vlastných budov alebo obnovu vrakov zničených vozidiel.

actor-rmbo =
    .name = Komando
    .description =
        Elitná ostreľovačská pechotná jednotka.
          Silná proti pechote a budovám
          Slabá proti vozidlám
    .encyclopedia =
        Commando je vybavené ostreľovacou puškou s dlhým dosahom, strieľa pomaly, ale pri dobrej podpore dokáže likvidovať nepriateľskú pechotu na diaľku.
        
        Nesie C4 na prekvapivé ničenie budov v tyle nepriateľa.

actor-pvice =
    .description =
    Zmutovaná obluda chrliaca tekuté Tiberium.
      Silná proti pechote a budovám
      Slabá proti lietadlám
    .encyclopedia =
    Zmutovaná forma života vzniknutá pôsobením zvláštnych vlastností Tiberia na pechotné jednotky.

    Rýchlo regenerujú zdravie a používajú zbraň na báze Tiberia s krátkym dosahom.

actor-steg =
    .name = Stegosaurus
    .description = Veľký, mohutne stavaný, bylinožravý štvornožec.

actor-trex =
    .name = Tyrannosaurus rex
    .description = Dvojnohý mäsožravec s masívnou lebkou.

actor-tric =
    .name = Triceratops
    .description = Štvornožec s veľkým kosteným golierom a tromi rohmi.

actor-rapt =
    .name = Velociraptor
    .description = Dvojnohý s predĺženým kosákovitým pazúrom na každej zadnej nohe.

