## aircraft.yaml
actor-tran =
    .name = Transport Chinook
    .description =
    Rýchly transportný vrtuľník pre pechotu.
      Neozbrojený
    .encyclopedia =
    Chinook je lietajúci transport schopný prevážať oddiel pechoty. Najčastejšie sa používa na presun komand alebo inžinierov na útoky v tyle nepriateľa.

    Tak ako všetky lietadlá, aj on môže v núdzi rozdrviť komandosa pristátím!

actor-heli =
    .name = Apache Longbow
    .description =
        Bojový vrtuľník s rotačnými guľometmi.
          Silný proti pechote, ľahkým vozidlám a lietadlám
          Slabý proti tankom
    .encyclopedia =
        Má viac odolnosti než Orca a slúži ako podporná jednotka. Výborne spolupracuje s delostrelectvom, pretože dokáže ničiť približujúce sa ľahké vozidlá.
        
        Munícia sa automaticky dopĺňa vo vzduchu.

actor-orca =
    .name = Orca
    .description =
        Bojový vrtuľník so strelami zem-vzduch.
          Silný proti budovám a tankom
          Slabý proti pechote
    .encyclopedia =
        Orca je rýchla, ale krehká jednotka, ktorá obťažuje nepriateľské vozidlá a lietadlá protitankovými raketami. Najlepšie sa používa oportunisticky a pri starostlivom ovládaní vydrží dlhšie nažive. Jej protilietadlové rakety sú účinné, ale ťažšie zasahujú rýchlo sa pohybujúce vzdušné ciele.
        
        Munícia sa automaticky dopĺňa vo vzduchu.

