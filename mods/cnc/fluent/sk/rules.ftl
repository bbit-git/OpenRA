## vehicles.yaml
actor-mcv =
    .name = Mobilné stavebné vozidlo
    .description =
    Rozvinie sa na stavebný dvor.
      Neozbrojené
    .encyclopedia =
    Rozvinutím sa MCV zmení na stavebný dvor. V rozvinutej forme má viac životov, no zbalenie môže pomôcť pri úniku pred pechotou.

    Ak máte spoluhráča, môže vám MCV “darovať” tak, že zničí nerozvinuté vozidlo pri vašej základni a vy ho následne zoberiete inžinierom.

actor-harv =
    .name = Zberač
    .generic-name = Zberač
    .description =
        Zbiera Tiberium na spracovanie.
          Neozbrojený
    .encyclopedia = Harvesteri pomaly ťažia Tiberium a vykladajú ho v rafinérii, kde sa premieňa na kredity. Môžu byť poslaní aj do spojeneckých rafinérií, aby poskytovali príjem.

notification-harvester-lost = Harvester stratený.

actor-apc =
    .name = APC
    .description =
    Ozbrojený transport pre pechotu.
    Môže útočiť na lietadlá.
      Silný proti vozidlám
      Slabý proti pechote
    .encyclopedia =
    APC (obrnený transportér pechoty) preváža pechotu, takže je vhodný na obsadzovanie civilných budov. Hoci jeho flakové delo nespôsobuje nepriateľským vozidlám veľké škody, APC dokáže znášať paľbu, zatiaľ čo Hum-vee spôsobujú poškodenie.

    Funguje aj ako vaša hlavná protilietadlová jednotka; po použití príkazu zastaviť znovu zameria blízke nepriateľské vzdušné jednotky.

actor-arty =
    .name = Artiléria
    .description =
        Delostrelectvo s dlhým dosahom.
          Silné proti pechote, vozidlám a budovám
    .encyclopedia =
        Delostrelectvo Nodu je sklenené delo: krehké, ale schopné spôsobovať veľké poškodenie na veľkú vzdialenosť. Je obzvlášť silné proti stavbám a pechote a dokáže ničiť nehybné tanky.
        
        Pri zoskupení je veľmi zraniteľné, pretože po zničení vybuchuje.

actor-ftnk =
    .name = Plameňometný tank
    .description =
        Ťažko obrnené vozidlo s plameňometom.
          Silné proti pechote, budovám a vozidlám
          Slabé proti tankom
    .encyclopedia = Spaľuje pechotu aj stavby, čo z neho robí výbornú jednotku na prekvapivé útoky. Dávajte si pozor na jeho plošné poškodenie pri zničení, no dá sa využiť aj vo váš prospech.

actor-bggy =
    .name = Bugina Nod
    .description =
        Rýchle prieskumné a protipechotné vozidlo.
          Silné proti pechote
          Slabé proti tankom
    .encyclopedia = Bugginy sú silné proti ľahkým vozidlám a pechote, skvele sa hodia na prieskum a likvidáciu izolovanej pechoty. Sú o niečo lacnejšie a rýchlejšie než Hum-vee GDI, ale aj krehkejšie.

actor-bike =
    .name = Prieskumná motorka
    .description =
        Rýchle prieskumné vozidlo s raketami.
        Môže útočiť na lietadlá.
          Silné proti vozidlám a tankom
          Slabé proti pechote
    .encyclopedia =
        Nod Bike je veľmi rýchle vozidlo vyzbrojené priebojnými raketami, čo z neho robí ideálnu jednotku na útoky hit-and-run a obťažovanie harvesterov.
        
        Pozor však na to, že jeho rakety sú pomalé a ťažko zasahujú rýchlo sa pohybujúce ciele.

actor-jeep =
    .name = Hum-vee
    .description =
        Rýchle prieskumné a protipechotné vozidlo.
          Silné proti pechote
          Slabé proti tankom
    .encyclopedia =
        Hum-vee je silné proti ľahkým vozidlám a pechote a výborne sa hodí na prieskum a likvidáciu izolovanej pechoty.
        
        Výborne si poradia so spamom Nod Bike a v takýchto stretoch by sa mali stavať namiesto tankov. Hoci sú o niečo pomalšie než Nod Buggy, majú viac životov.

actor-ltnk =
    .name = Ľahký tank
    .description =
        Rýchly ľahký tank.
          Silný proti vozidlám a tankom
          Slabý proti pechote
    .encyclopedia =
        Vďaka vysokej rýchlosti a veľkej zásobe životov funguje ľahký tank výborne ako frontová jednotka v rôznych zostavách napriek nižšiemu poškodeniu.
        
        Pri boji proti stredným tankom by sa mal kombinovať s motorkami, stealth tankami alebo pechotou.

actor-mtnk =
    .name = Stredný tank
    .description =
        Viacúčelový tank GDI.
          Silný proti tankom a vozidlám
          Slabý proti pechote
    .encyclopedia =
        Ťažný kôň GDI, ktorý ponúka dobrú rovnováhu medzi rýchlosťou, odolnosťou a palebnou silou. Ľahko zničí ľahké tanky Nodu a ak sa dostane do základne, dokáže trhať stavby.
        
        Pridávajte k armádam stredných tankov minigunnerov, aby ste si poradili s nepriateľskou pechotou.

actor-htnk =
    .name = Tank Mamut
    .description =
        Ťažko obrnený tank GDI.
        Môže útočiť na lietadlá.
          Silný proti všetkému
    .encyclopedia =
        Pomalá bojová stanica schopná samoopravy a boja proti akejkoľvek hrozbe. Je obzvlášť účinná proti nepriateľskému pancieru, ale dokáže ničiť aj menšie počty pechoty či lietadiel.
        
        V nepriateľskej základni ho prepnite do agresívneho postoja, aby pri pohybe razilo cestu skazy.

actor-msam =
    .name = Raketomet
    .description =
        Raketové delostrelectvo s dlhým dosahom.
          Silné proti všetkým pozemným jednotkám
    .encyclopedia =
        Hráči ho nazývajú „MLRS“ (Multiple Launch Rocket System). Táto delostrelecká platforma vypaľuje salvy rakiet na vzdialené ciele. Je obzvlášť účinná proti ľahkým vozidlám a spôsobuje slušné poškodenie pechote, budovám aj ťažkému pancieru.
        
        Je to silná jednotka proti nepriateľskému delostrelectvu; vysoká rýchlosť projektilov a poškodenie ľahkých vozidiel z nej robia perfektný protiťah na delostrelectvo Nodu.

actor-mlrs =
    .name = Mobilný systém SAM
    .description =
        Silná protilietadlová jednotka.
          Nemôže útočiť na pozemné jednotky.
    .encyclopedia = Hráči ju zvyčajne označujú ako „MSAM“. Toto vozidlo Nodu je špecializovaná protilietadlová jednotka pre prípady, keď samotné motorky nestačia. Vypaľuje pomaly letiace rakety so silným plošným poškodením.

actor-stnk =
    .name = Neviditeľný tank
    .description =
        Raketový tank s dlhým dosahom, ktorý sa dokáže maskovať.
        Môže útočiť na lietadlá.
        Má slabý pancier. Môže byť odhalený pechotou a
        obrannými stavbami.
          Silný proti vozidlám a tankom
          Slabý proti pechote
    .encyclopedia =
        Maskované jednotky, ktoré sa stanú viditeľnými pri poškodení alebo pri streľbe. Môžu ich odhaliť aj obrany v malom okruhu alebo pechota na vzdialenosť jedného poľa.
        
        Ich priebojné rakety s dlhým dosahom sú výborné proti nepriateľskému pancieru aj lietadlám. V núdzi dokážu rozdrviť aj pechotu.

actor-mhq =
    .name = Mobilné veliteľstvo
    .description =
    Mobilná základňa operácií.

actor-truck =
    .name = Zásobovacie vozidlo
    .description =
        Preváža peniaze ostatným hráčom.
        Stavia sa rýchlo
          Unarmed
    .encyclopedia = Zásobovacie nákladné autá sú pohodlným spôsobom, ako zdieľať hotovosť, keď váš spojenec nemá peniaze alebo vy nemôžete tie svoje míňať dostatočne rýchlo. Budujú sa oveľa rýchlejšie, než naznačuje ich cena.

