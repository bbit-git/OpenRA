## vehicles.yaml
actor-mcv =
    .name = Mobilní stavební vozidlo
    .description =
        Rozloží se na stavební dvůr.
          Neozbrojené
    .encyclopedia =
        Rozložením MCV se změní na stavební dvůr. V rozložené podobě má více odolnosti, ale jeho sbalení může pomoci uniknout pěchotě.
        
        Pokud máte spoluhráče, může vám MCV darovat tím, že zničí nerozložené vozidlo u vaší základny a vy si jej znovu přivlastníte inženýrem.

actor-harv =
    .name = Sklízeč
    .generic-name = Sklízeč
    .description =
        Sbírá Tiberium ke zpracování.
          Neozbrojený
    .encyclopedia = Sklízeče pomalu těží Tiberium a ukládají je do vaší rafinérie, kde se převádí na kredity. Mohou být také posláni do spojeneckých rafinérií a poskytovat finance.

notification-harvester-lost = Sklízeč ztracen.

actor-apc =
    .name = APC
    .description =
        Ozbrojený transportér pěchoty.
        Může útočit na letadla.
          Silný proti vozidlům
          Slabý proti pěchotě
    .encyclopedia =
        APC (obrněný transportér) přepravuje pěchotu, takže je užitečný při obsazování civilních budov. Jeho flakové dělo nepůsobí vozidlům velké škody, ale APC vydrží nepřátelskou palbu, zatímco vaše Hum-vee způsobují poškození.
        
        Funguje také jako vaše hlavní protiletadlová jednotka; pokud použijete příkaz zastavit, znovu zaměří blízké nepřátelské vzdušné jednotky.

actor-arty =
    .name = Dělostřelectvo
    .description =
        Dělostřelectvo dlouhého dosahu.
          Silné proti pěchotě, vozidlům a budovám
    .encyclopedia =
        Dělostřelectvo Nodu je skleněné dělo, křehké, ale schopné působit obrovské škody na velkou vzdálenost. Je obzvlášť silné proti budovám a pěchotě a dokáže ničit stojící tanky.
        
        Při seskupení je velmi zranitelné kvůli explozi při zničení.

actor-ftnk =
    .name = Plamenometný tank
    .description =
        Těžce obrněné vozidlo s plamenometem.
          Silné proti pěchotě, budovám a vozidlům
          Slabé proti tankům
    .encyclopedia = Spaluje pěchotu i budovy, takže je skvělý pro překvapivé útoky. Dávejte pozor na jeho plošné poškození při zničení, ale lze jej využít i ve svůj prospěch.

actor-bggy =
    .name = Bugina Nod
    .description =
        Rychlé průzkumné a protipěchotní vozidlo.
          Silné proti pěchotě
          Slabé proti tankům
    .encyclopedia = Bugginy jsou silné proti lehkým vozidlům a pěchotě a skvěle se hodí k průzkumu a likvidaci osamocené pěchoty. Jsou o něco levnější a rychlejší než GDI Hum-vee, ale také křehčí.

actor-bike =
    .name = Průzkumná motorka
    .description =
        Rychlé průzkumné vozidlo s raketami.
        Může útočit na letadla.
          Silné proti vozidlům a tankům
          Slabé proti pěchotě
    .encyclopedia =
        Motorka Nodu je velmi rychlé vozidlo vyzbrojené průbojnými raketami, díky čemuž je skvělá pro úder a ústup i obtěžování sklízečů.
        
        Pozor na to, že její rakety jsou pomalé a mají problém zasáhnout rychle se pohybující cíle.

actor-jeep =
    .name = Hum-vee
    .description =
        Rychlé průzkumné a protipěchotní vozidlo.
          Silné proti pěchotě
          Slabé proti tankům
    .encyclopedia =
        Hum-vee jsou silné proti lehkým vozidlům a pěchotě a skvěle se hodí k průzkumu a likvidaci izolované pěchoty.
        
        Výborně si poradí se spamem motorek Nodu a v takových střetech by se měly stavět místo tanků. Jsou sice o něco pomalejší než Nod Buggy, ale mají více odolnosti.

actor-ltnk =
    .name = Lehký tank
    .description =
        Rychlý lehký tank.
          Silný proti vozidlům a tankům
          Slabý proti pěchotě
    .encyclopedia =
        Díky své vysoké rychlosti a odolnosti funguje lehký tank výborně jako jednotka první linie v různých sestavách navzdory nižšímu poškození.
        
        Při střetu se středními tanky by měl být kombinován s motorkami, maskovanými tanky nebo pěchotou.

actor-mtnk =
    .name = Střední tank
    .description =
        Víceúčelový tank GDI.
          Silný proti tankům a vozidlům
          Slabý proti pěchotě
    .encyclopedia =
        Pracovní kůň GDI nabízející dobrý poměr rychlosti, odolnosti a palebné síly. Snadno zničí lehké tanky Nodu a pokud pronikne do základny, může roztrhat budovy.
        
        Proti nepřátelské pěchotě míchejte do armád středních tanků minigunnery.

actor-htnk =
    .name = Tank Mammoth
    .description =
        Těžce obrněný tank GDI.
        Může útočit na letadla.
          Silný proti všemu.
    .encyclopedia =
        Kráčející bojová stanice schopná samoopravy a boje s jakoukoli hrozbou. Je obzvláště účinná proti nepřátelskému obrnění, ale dokáže zničit i menší množství pěchoty nebo letadel.
        
        Když se nacházíte v nepřátelské základně, přepněte jej do agresivního postoje, aby při pohybu vytvářel cestu zkázy.

actor-msam =
    .name = Raketomet
    .description =
        Raketové dělostřelectvo s dlouhým dostřelem.
          Silný proti všem pozemním jednotkám.
    .encyclopedia =
        Tato dělostřelecká platforma, hráči označovaná jako „MLRS“ (Multiple Launch Rocket System), pálí salvy raket na vzdálené cíle. Je obzvláště účinná proti lehkým vozidlům a způsobuje střední poškození pěchotě, budovám a těžkému obrnění.
        
        Silná jednotka proti nepřátelskému dělostřelectvu. Její vysoká úsťová rychlost a poškození lehkých vozidel z ní dělá ideální protizbraň pro dělostřelectvo Nodu.

actor-mlrs =
    .name = Mobilní SAM
    .description =
        Výkonná protivzdušná jednotka.
          Nemůže útočit na pozemní cíle.
    .encyclopedia = Toto vozidlo Nodu, hráči obecně označované jako „MSAM“, je specializovaným protivzdušným prostředkem pro případy, kdy motorky nestačí. Odpaluje pomalé rakety se silným rozptýleným poškozením.

actor-stnk =
    .name = Neviditelný tank
    .description =
        Raketový tank s dlouhým dostřelem, který se dokáže maskovat.
        Může útočit na letadla.
        Má slabé pancéřování. Může být odhalen pěchotou a
        obrannými budovami.
          Silný proti vozidlům a tankům.
          Slabý proti pěchotě.
    .encyclopedia =
        Neviditelné jednotky, které se zviditelní při poškození nebo palbě. Mohou být také odhaleny obranou v malém okruhu nebo pěchotou na vzdálenost jednoho pole.
        
        Jejich protipancéřové rakety dlouhého doletu jsou vynikající pro boj s nepřátelským obrněním nebo letectvem. V nouzi mohou také drtit pěchotu.

actor-mhq =
    .name = Mobilní HQ
    .description = Mobilní základna operací.

actor-truck =
    .name = Nákladní auto se zásobami
    .description =
        Převáží hotovost ostatním hráčům.
        Staví se rychle.
          Beze zbraně
    .encyclopedia = Nákladní vozy se zásobami jsou pohodlným způsobem, jak sdílet hotovost, když vašemu spojenci dojdou peníze, nebo když ty své nedokážete utrácet dostatečně rychle. Staví se mnohem rychleji, než napovídá jejich cena.

