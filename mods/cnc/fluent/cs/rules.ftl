## infantry.yaml
actor-e1 =
    .name = Střelec
    .description =
        Víceúčelová pěchota.
          Silná proti pěchotě
          Slabá proti vozidlům
    .encyclopedia =
        Skromný střelec (Minigunner) je vysoce specializovaná pěchotní jednotka navržená tak, aby pohlcovala poškození a likvidovala jinou pěchotu.
        
        Jako většina jednotek v TD vidí dál, než dostřelí, a nejlépe fungují ve skupinách při eliminaci nepřátelské pěchoty.

actor-e2 =
    .name = Granátník
    .description =
        Rychlá pěchota s granáty.
          Silný proti budovám a pomalým cílům.
    .encyclopedia =
        Rychlý a schopný držet krok se středními tanky, což mu umožňuje dobře spolupracovat s křídelními armádami.
        
        Ačkoliv není tak silný jako střelec nebo raketometčík, jeho rychlost lze využít ve váš prospěch.

actor-e3 =
    .name = Raketometčík
    .description =
        Protivzdušná a protitanková pěchota.
          Silný proti tankům a letadlům.
          Slabý proti pěchotě.
    .encyclopedia =
        Vysoce zranitelný, ale vynikající v eliminaci nepřátelského obrnění a letectva. Je to nejpomalejší jednotka ve hře, zaostává za ostatní pěchotou i tanky Mammoth.
        
        Jeho velký dostřel kompenzuje nízkou rychlost, díky čemuž je nejúčinnější při defenzivním použití, kde může být chráněn a poskytovat výhled.

actor-e4 =
    .name = Plamenometčík
    .description =
        Pokročilá protipěchotní jednotka.
          Silný proti pěchotě a budovám.
          Slabý proti tankům.
    .encyclopedia = Dobrý pro obchvaty a vypalování budov. Má více zdraví než standardní střelec, ale jeho krátký dostřel ztěžuje jeho použití ve velkých armádách.

actor-e5 =
    .name = Chemický válečník
    .description =
        Pokročilá všestranná pěchota.
          Silný proti všem pozemním jednotkám.
    .encyclopedia =
        Podobné statistiky jako plamenometčík, ale způsobuje dobré poškození těžkému obrnění. Skvělý pro zastavení nepřátelských tanků před rozdrcením vašich sil.
        
        Může chodit po tiberiu, aniž by utrpěl poškození, což je obzvláště užitečné pro obtěžování sběračů na určitých mapách.

actor-e6 =
    .name = Inženýr
    .description =
        Poškozuje a obsazuje nepřátelské budovy.
        Opravuje zničená vozidla.
          Beze zbraně
    .encyclopedia =
        Podobně jako raketometčík je inženýr pomalý a vyžaduje doprovod k efektivnímu použití. Dokáže okamžitě obsadit budovy, ale při tomto procesu je spotřebován.
        
        K obsazení civilní budovy stačí pouze jeden inženýr, zatímco k obsazení nepřátelské budovy jsou obvykle potřeba dva inženýři, nebo jeden, pokud je budova těžce poškozená.
        
        Inženýři mohou být také použiti k opravě vlastních budov nebo k obnově vraků zničených vozidel.

actor-rmbo =
    .name = Komando
    .description =
        Elitní odstřelovačská pěchota.
          Silný proti pěchotě a budovám.
          Slabý proti vozidlům.
    .encyclopedia =
        Komando, vybavené odstřelovací puškou s dlouhým dosahem, pálí pomalu, ale při dobré podpoře dokáže eliminovat nepřátelskou pěchotu z dálky.
        
        Nese trhavinu C4 pro překvapivé ničení nepřátelských budov v týlu.

actor-pvice =
    .description =
        Zmutovaná ohavnost, která plive tekuté tiberium.
          Silný proti pěchotě a budovám.
          Slabý proti letadlům.
    .encyclopedia =
        Zmutovaná životní forma vytvořená z podivných vlastností tiberia, když jsou mu pěchotní jednotky vystaveny.
        
        Rychle regenerují zdraví a mají tiberiovou zbraň krátkého dosahu.

actor-steg =
    .name = Stegosaurus
    .description =
        Velký, mohutně stavěný,
        býložravý čtvernožec.

actor-trex =
    .name = Tyrannosaurus rex
    .description =
        Dvounohý masožravec s
        mohutnou lebkou.

actor-tric =
    .name = Triceratops
    .description =
        Čtvernožec s velkým kostěným
        límcem a třemi rohy.

actor-rapt =
    .name = Velociraptor
    .description =
        Dvounohý tvor se zvětšeným srpovitým
        drápeм na každé zadní noze.

