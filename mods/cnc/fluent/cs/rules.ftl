## aircraft.yaml
actor-tran =
    .name = Transportní Chinook
    .description =
        Rychlý transportní vrtulník pro pěchotu.
          Neozbrojen
    .encyclopedia =
        Chinook je létající transport schopný přepravit oddíl pěchoty. Nejčastěji se používá k přepravě komand nebo inženýrů k ničení týlových cílů.
        
        Jako všechna letadla může být v nouzi užitečný i k rozdrcení komanda přistáním!

actor-heli =
    .name = Apache Longbow
    .description =
        Bojový vrtulník s rotačními kulomety.
          Silný proti pěchotě, lehkým vozidlům a letadlům
          Slabý proti tankům
    .encyclopedia =
        Má více odolnosti než Orca a funguje jako podpůrná jednotka. Dobře spolupracuje s dělostřelectvem, protože dokáže ničit přibližující se lehká vozidla.
        
        Munice se automaticky doplňuje ve vzduchu.

actor-orca =
    .name = Orca
    .description =
        Bojový vrtulník se střelami vzduch-země.
          Silný proti budovám a tankům
          Slabý proti pěchotě
    .encyclopedia =
        Rychlá, ale křehká Orca obtěžuje nepřátelská vozidla a letadla protitankovými střelami. Nejlépe se používá příležitostně a při pečlivém mikromanagementu vydrží déle. Její protiletadlové střely jsou účinné, ale hůře zasahují rychle se pohybující vzdušné cíle.
        
        Munice se automaticky doplňuje ve vzduchu.

