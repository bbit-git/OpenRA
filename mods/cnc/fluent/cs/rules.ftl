actor-fact =
    .name = Stavební dvůr
    .description = Staví budovy.
    .encyclopedia =
        Jádro každé základny. Produkuje budovy a obranu a zároveň poskytuje stavební dosah. Má velkou zásobu zdraví, ale je těžké jej nahradit, takže je zásadní jej bránit.
        
        Pomocí klávesy pro rozložení jej lze sbalit do mobilní verze, ale chvíli to trvá.

actor-fact-gdi-name = Stavební dvůr GDI
actor-fact-nod-name = Stavební dvůr Nodu

actor-nuke =
    .name = Elektrárna
    .description = Vyrábí energii.
    .encyclopedia = Poskytuje energii budovám ve vaší základně. Výkon přímo závisí na stavu elektrárny

actor-nuk2 =
    .name = Pokročilá elektrárna
    .description =
        Poskytuje více energie a je levnější než
        standardní elektrárna.
    .encyclopedia = Poskytuje více energie budovám ve vaší základně

actor-proc =
    .name = Rafinérie Tiberia
    .description =
        Zpracovává surové Tiberium
        na použitelné zdroje.
    .encyclopedia =
        Skladuje a zpracovává mimozemský materiál a surovinu Tiberium. Sklízeče sbírají Tiberium v poli a ukládají jej do rafinérie, kde se převádí na kredity.
        
        Rafinérie Tiberium skladuje a po dokončení okamžitě nasadí sklízeč. Pro blízké zpracování zvládne maximálně 3 sklízeče.

actor-silo =
    .name = Silo Tiberia
    .description = Ulozits processed Tiberium.
    .encyclopedia =
        Skladuje kredity. Pokud je úložiště plné, sklízeče budou čekat, dokud se kredity neutratí.
        
        Užitečné při těžbě cennějšího modrého Tiberia, protože jedna rafinérie nepojme plný náklad.

actor-pyle =
    .name = Kasárna
    .description = Cvičí pěchotu.
    .encyclopedia = Produkuje pěchotu pro GDI. Po odemčení jsou pokročilé jednotky GDI silné a rychlé.

actor-hand =
    .name = Ruka Nodu
    .description = Cvičí pěchotu.
    .encyclopedia = Produkuje pěchotu pro Nod. Po odemčení je pokročilá pěchota Nodu pomalá

actor-afld =
    .name = Přistávací dráha
    .description =
        Poskytuje výsadkovou zónu
        pro vozidla jako posily.
    .encyclopedia = Doručuje vozidla Nodu letadlem. Vozidla Nodu jsou rychlá

actor-weap =
    .name = Továrna na zbraně
    .description = Produkuje vozidla.
    .encyclopedia = Produkuje vozidla pro GDI. Vozidla GDI bývají pomalá

actor-hpad =
    .name = Heliport
    .description = Produkuje a opravuje vrtulníky.
    .encyclopedia = Produkuje a opravuje vrtulníky. Pro stavbu pokročilých útočných vrtulníků vyžaduje komunikační centrum.

actor-hq =
    .name = Komunikační centrum
    .description =
        Poskytuje radar a podpůrnou schopnost Letecký úder.
        Odemyká pokročilejší jednotky a budovy.
        K provozu vyžaduje energii.
    .airstrikepower-name = Letecký úder
    .airstrikepower-description =
        Provede letecký napalmový úder.
        Spaluje budovy a pěchotu podél linie.
    .encyclopedia = Při dostatku energie dává hráči přístup k minimapě (vpravo nahoře). Odemyká nové jednotky a zároveň poskytuje přístup k podpůrné schopnosti leteckého úderu.

actor-fix =
    .name = Opravit Facility
    .description = Opravits vehicles.
    .encyclopedia = Opravuje vozidla. Příkaz k opravě lze použít na jednotky a poslat je do nejbližší opravárenské budovy.

actor-eye =
    .name = Pokročilé komunikační centrum
    .description =
        Poskytuje radar a podpůrnou schopnost Orbitální iontový kanón.
        Odemyká tank Mammoth a Komandosa.
        K provozu vyžaduje energii.
    .ioncannonpower-name = Iontový kanón
    .ioncannonpower-description =
        Spustí úder iontového kanónu.
        Okamžitě způsobí poškození v malé oblasti.
    .encyclopedia = Odemyká pokročilé jednotky a podpůrnou schopnost iontového kanónu. Pokud je komunikační centrum zničeno

actor-tmpl =
    .name = Chrám Nodu
    .description =
        Poskytuje podpůrnou schopnost Jaderný úder.
        Odemyká maskovaný tank, chemického bojovníka a Obelisk světla.
        K provozu vyžaduje energii.
    .nukepower-name = Jaderný úder
    .nukepower-description =
        Odpálí taktickou jadernou hlavici.
        Způsobí těžké poškození na velké ploše.
    .encyclopedia = Odemyká pokročilé jednotky a podpůrnou schopnost jaderného útoku. Udržuje odemknuté jednotky dostupné i po ztrátě komunikačního centra.

actor-gun =
    .name = Věž
    .description =
        Základní protitanková obrana základny.
          Silná proti tankům a vozidlům
          Slabá proti pěchotě
    .encyclopedia = Obrana základny vyzbrojená protipancéřovým kanónem, způsobuje značné poškození vozidlům v dosahu.

actor-sam =
    .name = Raketová základna (SAM)
    .description =
        Protivzdušná obrana základny.
