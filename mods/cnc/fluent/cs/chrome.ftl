button-command-bar-attack-move =
    .tooltip = Utok pohybem
    .tooltipdesc =
        Vybrane jednotky se presunou na urcene misto
        a napadnou vsechny nepratele, ktere cestou potkaji.
        
        Podrzte <(Ctrl)> pri zamereni pro rozkaz k utocnemu pohybu,
        ktery napadne vsechny jednotky nebo budovy po ceste.
        
        Kliknete levym tlacitkem na ikonu a potom pravym na cilove misto.

button-command-bar-force-move =
    .tooltip = Vynutit pohyb
    .tooltipdesc =
        Vybrane jednotky se presunou na urcene misto
         - Vychozi cinnost cile bude potlacena
         - Vozidla se pokusi rozdrtit nepratele v cilovem miste
         - Vrtulniky pristanu v cilovem miste
        
        Kliknete levym tlacitkem na ikonu a potom pravym na cil.
        Podrzte <(Alt)> pro docasnou aktivaci pri vydavani rozkazu jednotkam.

button-command-bar-force-attack =
    .tooltip = Vynutit utok
    .tooltipdesc =
        Vybrane jednotky zautoci na cilovou jednotku nebo misto
         - Vychozi cinnost cile bude potlacena
         - Umoznuje zamirit na vlastni nebo spojenecke sily
         - Delekodosahove delostrelectvo bude vzdy mirit
           na misto a ignorovat jednotky i budovy
        
        Kliknete levym tlacitkem na ikonu a potom pravym na cil.
        Podrzte <(Ctrl)> pro docasnou aktivaci pri vydavani rozkazu jednotkam.

button-command-bar-guard =
    .tooltip = Strazit
    .tooltipdesc =
        Vybrane jednotky budou nasledovat cilovou jednotku.
        
        Kliknete levym tlacitkem na ikonu a potom pravym na cilovou jednotku.

button-command-bar-deploy =
    .tooltip = Nasadit
    .tooltipdesc =
        Vybrane jednotky provedou svou vychozi cinnost po rozlozeni
         - MCV se rozlozi na stavebni dvur
         - Stavebni dvory se znovu slozi na MCV
         - Transporty vysadi sve pasazery
        
        Provede se okamzite na vybranych jednotkach.

button-command-bar-scatter =
    .tooltip = Rozptylit
    .tooltipdesc =
        Vybrane jednotky zastavi svou aktualni cinnost
        a presunou se na blizke misto.
        
        Provede se okamzite na vybranych jednotkach.

button-command-bar-stop =
    .tooltip = Zastavit
    .tooltipdesc =
        Vybrane jednotky zastavi svou aktualni cinnost.
        Vybrane budovy resetuji svuj shromazdovaci bod.
        
        Provede se okamzite na vybranych cilech.

button-command-bar-queue-orders =
    .tooltip = Rezim tras
    .tooltipdesc =
        Pomoci rezimu tras muzete vybranym jednotkam zadat
        vice navazujicich rozkazu. Jednotky je zacnou plnit
        okamzite po jejich obdrzeni.
        
        Kliknete levym tlacitkem na ikonu a pak zadavejte rozkazy ve hre.
        Podrzte <(Shift)> pro docasnou aktivaci pri vydavani rozkazu jednotkam.

button-stance-bar-attackanything =
    .tooltip = Postoj utocit na vse
    .tooltipdesc =
        Nastavi vybrane jednotky do postoje utocit na vse:
         - Jednotky budou utocit na nepratelske jednotky a budovy na dohled
         - Jednotky budou pronasledovat utocniky po bitevnim poli

button-stance-bar-defend =
    .tooltip = Obranny postoj
    .tooltipdesc =
        Nastavi vybrane jednotky do obranneho postoje:
         - Jednotky budou utocit na nepratelske jednotky na dohled
         - Jednotky se nebudou pohybovat ani pronasledovat nepratele

button-stance-bar-returnfire =
    .tooltip = Postoj opetovat palbu
    .tooltipdesc =
        Nastavi vybrane jednotky do postoje opetovat palbu:
         - Jednotky budou opetovat palbu proti nepratelum, kteri na ne zautoci
         - Jednotky se nebudou pohybovat ani pronasledovat nepratele

button-stance-bar-holdfire =
    .tooltip = Postoj nepalit
    .tooltipdesc =
        Nastavi vybrane jednotky do postoje nepalit:
         - Jednotky nebudou strilet na nepratele
         - Jednotky se nebudou pohybovat ani pronasledovat nepratele

