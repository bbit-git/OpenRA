## ingame-player.yaml
button-command-bar-force-move =
    .tooltip = Vynutit pohyb
    .tooltipdesc =
        Vybrané jednotky se přesunou na požadované místo
         - Výchozí činnost vůči cíli bude potlačena
         - Vozidla se pokusí rozdrtit nepřátele v cílové oblasti
         - Rozložené thumpery se sbalí a přesunou do cílové oblasti
        
        Klikněte levým tlačítkem na ikonu a pak pravým na cíl.
        Podržením <(Alt)> funkci dočasně aktivujete při vydávání rozkazů jednotkám.

button-command-bar-force-attack =
    .tooltip = Vynutit utok
    .tooltipdesc =
        Vybrané jednotky zaútočí na cílovou jednotku nebo místo
         - Výchozí činnost vůči cíli bude potlačena
         - Umožňuje zaměřit vlastní nebo spojenecké síly
        
        Klikněte levým tlačítkem na ikonu a pak pravým na cíl.
        Podržením <(Ctrl)> funkci dočasně aktivujete při vydávání rozkazů jednotkám.

button-command-bar-guard =
    .tooltip = Strazit
    .tooltipdesc =
        Vybrané jednotky budou následovat cílovou jednotku.
        
        Klikněte levým tlačítkem na ikonu a pak pravým na cílovou jednotku.

button-command-bar-deploy =
    .tooltip = Nasadit
    .tooltipdesc =
        Vybrané jednotky provedou svou výchozí činnost rozložení
         - MCV se rozloží na stavební dvůr
         - Thumpery začnou nebo přestanou přitahovat červy
         - Devastatory se znehybní a vybuchnou


