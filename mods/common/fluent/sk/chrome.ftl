## ingame-player.yaml
supportpowers-support-powers-palette =
    .ready = READY
    .hold = ZAČKAŤ

button-command-bar-attack-move =
    .tooltip = Útok Pohyb
    .tooltipdesc =
        Vybrané jednotky sa presunú na požadované miesto
        a zaútočiť na všetkých nepriateľov, ktorých na ceste stretnú.
        
        Podržte <(Ctrl)> pri zameriavaní, aby ste nariadili útočný pohyb
        ktorý útočí na všetky jednotky alebo štruktúry, s ktorými sa stretnete na ceste.
        
        Kliknite ľavým tlačidlom myši na ikonu a potom kliknite pravým tlačidlom myši na cieľové umiestnenie.

button-command-bar-guard =
    .tooltip = Strážca
    .tooltipdesc =
        Vybrané jednotky budú nasledovať cieľovú jednotku.
        
        Kliknite ľavým tlačidlom myši na ikonu a potom kliknite pravým tlačidlom myši na cieľovú jednotku.

button-command-bar-scatter =
    .tooltip = Rozptyl
    .tooltipdesc =
        Vybrané jednotky zastavia svoju aktuálnu činnosť
        a presuňte sa na blízke miesto.
        
        Okamžite pôsobí na vybrané jednotky.

button-command-bar-stop =
    .tooltip = Zastaviť
    .tooltipdesc =
        Vybrané jednotky zastavia svoju aktuálnu činnosť.
        Vybraným budovám sa obnoví miesto stretnutia.
        
        Okamžite pôsobí na vybrané ciele.

button-command-bar-queue-orders =
    .tooltip = Režim trasového bodu
    .tooltipdesc =
        Použite režim bodu na zadanie viacerých príkazov na prepojenie
        k vybraným jednotkám. Jednotky vykonajú príkazy
        ihneď po ich obdržaní.
        
        Kliknite ľavým tlačidlom myši na ikonu a potom zadajte príkazy v hernom svete.
        Podržte <(Shift)> na dočasnú aktiváciu počas ovládania jednotiek.

button-stance-bar-attackanything =
    .tooltip = Postoj Attack Anything
    .tooltipdesc =
        Nastavte vybrané jednotky na postoj Attack Anything:
         - Jednotky budú útočiť na nepriateľské jednotky a štruktúry na dohľad
         - Jednotky budú prenasledovať útočníkov cez bojisko

button-stance-bar-defend =
    .tooltip = Obhajovať postoj
    .tooltipdesc =
        Nastavte vybrané jednotky na obranu:
         - Jednotky zaútočia na nepriateľské jednotky na dohľad
         - Jednotky sa nebudú pohybovať ani prenasledovať nepriateľov

button-stance-bar-returnfire =
    .tooltip = Opätovný palebný postoj
    .tooltipdesc =
        Nastavte vybraté jednotky na pozíciu Opätovná streľba:
         - Jednotky sa pomstia proti nepriateľom, ktorí na ne zaútočia
         - Jednotky sa nebudú pohybovať ani prenasledovať nepriateľov

button-stance-bar-holdfire =
    .tooltip = Držte ohnivý postoj
    .tooltipdesc =
        Nastavte vybrané jednotky na pozíciu Hold Fire:
         - Jednotky nebudú strieľať na nepriateľov
         - Jednotky sa nebudú pohybovať ani prenasledovať nepriateľov

