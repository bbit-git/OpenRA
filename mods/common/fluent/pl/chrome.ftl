    .hold = POZASTAVENO

button-command-bar-attack-move =
    .tooltip = Útočný přesun
    .tooltipdesc =
    Vybrané jednotky se přesunou na určené místo
    a zaútočí na všechny nepřátele na cestě.

    Podržte <(Ctrl)> při zaměřování pro útočný výpad,
    který útočí na všechny jednotky nebo budovy na cestě.

    Klikněte levým tlačítkem na ikonu a poté pravým na cílové místo.

button-command-bar-guard =
    .tooltip = Hlídkovat
    .tooltipdesc =
    Vybrané jednotky budou následovat cílovou jednotku.

    Klikněte levým tlačítkem na ikonu a poté pravým na cílovou jednotku.

button-command-bar-scatter =
    .tooltip = Rozptýlit
    .tooltipdesc =
    Vybrané jednotky přeruší svou aktuální činnost
    a přesunou se na blízké místo.

    Okamžitě působí na vybrané jednotky.

button-command-bar-stop =
    .tooltip = Zastavit
    .tooltipdesc =
    Vybrané jednotky přeruší svou aktuální činnost.
    Vybrané budovy obnoví svůj shromažďovací bod.

    Okamžitě působí na vybrané cíle.

button-command-bar-queue-orders =
    .tooltip = Režim trasových bodů
    .tooltipdesc =
    Použijte režim trasových bodů k zadání více navazujících
    příkazů vybraným jednotkám. Jednotky provedou příkazy
    okamžitě po jejich přijetí.

    Klikněte levým tlačítkem na ikonu a poté zadávejte příkazy ve hře.
    Podržte <(Shift)> pro dočasnou aktivaci při ovládání jednotek.

button-stance-bar-attackanything =
    .tooltip = Postoj útoku na vše
    .tooltipdesc =
    Nastavit vybraným jednotkám postoj útoku na vše:
     - Jednotky budou útočit na nepřátelské jednotky a budovy na dohled
     - Jednotky budou pronásledovat útočníky po celém bojišti

button-stance-bar-defend =
    .tooltip = Obranný postoj
    .tooltipdesc =
    Nastavit vybraným jednotkám obranný postoj:
     - Jednotky budou útočit na nepřátelské jednotky na dohled
     - Jednotky se nebudou přesouvat ani pronásledovat nepřátele

button-stance-bar-returnfire =
    .tooltip = Postoj opětování palby
    .tooltipdesc =
    Nastavit vybraným jednotkám postoj opětování palby:
     - Jednotky budou opětovat palbu nepřátelům, kteří na ně útočí
     - Jednotky se nebudou přesouvat ani pronásledovat nepřátele

button-stance-bar-holdfire =
    .tooltip = Postoj zastavení palby
    .tooltipdesc =
    Nastavit vybraným jednotkám postoj zastavení palby:
     - Jednotky nebudou střílet na nepřátele
     - Jednotky se nebudou přesouvat ani pronásledovat nepřátele

